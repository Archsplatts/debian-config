{
	"custom/updates": {
	    "exec": "$HOME/.config/waybar/scripts/checkupdates", 
	    "on-click": "$HOME/.config/waybar/scripts/checkupdates; pkill -SIGRTMIN+1 waybar", 
	    "interval": 3600, 
	    "return-type": "json",
	    "format": "{0}{icon}",
	    "format-icons": {
	        "has-updates": "",
	        "updated": "" 
	    }
	},
}
