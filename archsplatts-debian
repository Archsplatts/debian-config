mkdir -p ~/.config
mkdir -p ~/Images/Wallpapers
mkdir -p ~/.scripts
mkdir -p $HOME/.local/share/themes
mkdir -p $HOME/.local/share/fonts
cp -r ~/debian-config/config/* ~/.config
cp ~/debian-config/call-it-a-day.jpg ~/Images/Wallpapers
cp ~/debian-config/papirus-folders ~/.scripts
cp zshrc $HOME/.zshrc
chmod u+x ~/.scripts/papirus-folders
chmod u+x ~/.config/rofi/scripts/*
chmod u+x ~/.config/sway/scripts/*
  
echo -e "${VERT}╔════════════════════════════════════════╗${NC}"
echo -e "${VERT}║  Installation terminée avec succès !   ║${NC}"
echo -e "${VERT}╚════════════════════════════════════════╝${NC}\n"

echo -e "${JAUNE}⚠ Veuillez redémarrer votre système pour appliquer tous les changements.${NC}\n"
