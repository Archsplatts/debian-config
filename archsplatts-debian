UTILS_PKGS=(
	"bat"
	"breeze-cursor-theme"
	"btop"
	"calcurse"
	"du-dust"
	"eza"
	"fastfetch"
	"papirus-icon-theme"
	"unzip"
	"zip"
	"xarchiver"
)

sudo nala install -y "${UTILS_PKGS[@]}"

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
