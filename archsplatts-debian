echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

SWAY_PKGS=(
	"autotiling"
	"flameshot" 
	"foot"
	"grim"
	"gvfs"
	"mako-notifier" 
	"rofi" 
	"sway" 
	"swaybg" 
	"slurp"
	"thunar" 
	"thunar-archive-plugin" 
	"thunar-volman"
	"timeshift"
	"ufw" 
	"xdg-desktop-portal" 
	"xdg-desktop-portal-gtk" 
	"xdg-desktop-portal-wlr" 
	"xwayland"
)

sudo nala install -y "${SWAY_PKGS[@]}"

