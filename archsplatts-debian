APPS_PKGS=(
	"firefox-esr"
	"galculator"
	"gnome-disk-utility"
	"lollypop"
	"mpv"
	"nwg-look"
	"pavucontrol"
	"qbittorrent"
	"ristretto"
	"thunderbird"
	"zathura"
	"zathura-pdf-poppler" 	
)

sudo nala install -y "${APPS_PKGS[@]}"

